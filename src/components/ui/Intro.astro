---
// One-time P5-style intro. Shown only when <html data-intro> is set by the
// pre-paint gate in PersonaLayout (first visit, or ?intro to replay).
// Timeline is beat-locked: BEAT = 0.45s; exit hit lands on beat 7 (3.15s).

const name = "AYUSH DEO";
const looks = ["a", "b", "c", "d", "e", "f"];
const tilts = [-8, 6, -4, 9, -6, 4, -9, 5];
let k = 0;
const words = name.split(" ").map((w, wi) =>
    [...w].map((ch) => {
        const i = k++;
        // letters land on 16ths after beat 2, with a breath between words
        const delay = +(0.9 + i * 0.11 + (wi > 0 ? 0.12 : 0)).toFixed(2);
        return { ch, look: looks[(i * 7) % looks.length], tilt: tilts[i % tilts.length], delay };
    }),
);
---

<div id="p5-intro" role="dialog" aria-modal="true" aria-label="Intro">
    <!-- ===================== TITLE SCREEN (waits for a click) -->
    <section class="title" data-title>
        <div class="t-red"></div>
        <div class="t-dots"></div>
        <div class="t-star"></div>

        <div class="t-inner">
            <p class="t-kicker">A PHANTOM PORTFOLIO</p>
            <p class="t-logo" aria-hidden="true">
                <span class="w1">TAKE</span>
                <span class="w2">YOUR</span>
                <span class="w3">SHOT</span>
            </p>
            <button class="t-start" type="button" data-start>
                <span>▶ PRESS START</span>
            </button>
            <p class="t-hint">
                Best with sound on · or <button type="button" class="t-silent" data-silent>enter silently</button>
            </p>
        </div>

        <button class="t-skip" type="button" data-skip>SKIP ▸▸</button>
    </section>

    <!-- ===================== THE SHOW (plays after the click) -->
    <section class="show" aria-hidden="true">
        <div class="s-slash s-red"></div>
        <div class="s-burst"></div>
        <div class="s-slash s-seam"></div>
        <div class="s-slash s-black"></div>
        <div class="s-dots"></div>

        <div class="s-name">
            <p class="s-stamp">TAKE YOUR SHOT</p>
            {
                words.map((w) => (
                    <span class="s-word">
                        {w.map((g) => (
                            <span
                                class={`s-l s-${g.look}`}
                                data-d={g.delay}
                                style={`--d:${g.delay}s;--r:${g.tilt}deg`}
                            >
                                {g.ch}
                            </span>
                        ))}
                    </span>
                ))
            }
            <div class="s-tag"><span>APPLIED AI · LANGUAGE SYSTEMS · USC</span></div>
        </div>

        <div class="s-flash"></div>
    </section>
</div>

<style>
    #p5-intro {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: none;
        font-family: "Anton", sans-serif;
        -webkit-font-smoothing: antialiased;
    }
    :global(html[data-intro]) #p5-intro {
        display: block;
    }
    button {
        font: inherit;
        cursor: pointer;
    }

    /* ---------------------------------------------- title screen */
    .title {
        position: absolute;
        inset: 0;
        background: #0b0b0b;
        overflow: hidden;
        display: grid;
        place-items: center;
        cursor: pointer;
    }
    .t-red {
        position: absolute;
        inset: 0;
        background: #e60012;
        clip-path: polygon(60% 0, 100% 0, 100% 100%, 36% 100%);
        animation: t-red 0.7s cubic-bezier(0.2, 0.9, 0.2, 1) both;
    }
    @keyframes t-red {
        from { transform: translateX(70%); }
    }
    .t-dots {
        position: absolute;
        inset: 0;
        background: radial-gradient(rgba(0, 0, 0, 0.45) 1.4px, transparent 1.9px) 0 0 / 9px 9px;
        clip-path: polygon(60% 0, 100% 0, 100% 100%, 36% 100%);
        opacity: 0.55;
    }
    .t-star {
        position: absolute;
        width: 95vmin;
        height: 95vmin;
        left: 50%;
        top: 50%;
        translate: -50% -50%;
        background: #fff;
        opacity: 0.06;
        clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
        animation: spin 40s linear infinite;
    }
    @keyframes spin {
        to { transform: rotate(360deg); }
    }
    .t-inner {
        position: relative;
        text-align: center;
        padding: 0 1.25rem;
        animation: t-in 0.6s 0.15s cubic-bezier(0.2, 0.9, 0.2, 1) both;
    }
    @keyframes t-in {
        from { opacity: 0; transform: translateY(24px); }
    }
    .t-kicker {
        display: inline-block;
        font-family: "Inter", sans-serif;
        font-weight: 900;
        font-size: 0.75rem;
        letter-spacing: 0.4em;
        color: #0b0b0b;
        background: #f5c400;
        padding: 0.3em 0.9em;
        transform: skewX(-12deg);
        margin-bottom: 1.4rem;
    }
    .t-logo {
        display: flex;
        flex-direction: column;
        align-items: center;
        font-style: italic;
        font-size: clamp(3.4rem, 10vw, 8.5rem);
        line-height: 0.82;
        letter-spacing: -0.02em;
        transform: rotate(-6deg);
        margin: 0 0 2.4rem;
    }
    .t-logo .w1 { color: #fff; -webkit-text-stroke: 3px #0b0b0b; text-shadow: 7px 7px 0 #0b0b0b; margin-left: -0.6em; }
    .t-logo .w2 { color: #0b0b0b; -webkit-text-stroke: 2px #fff; text-shadow: 5px 5px 0 #fff; margin-left: 0.5em; }
    .t-logo .w3 { color: #e60012; -webkit-text-stroke: 4px #0b0b0b; text-shadow: 9px 9px 0 #0b0b0b; font-size: 1.15em; }

    .t-start {
        font-size: clamp(1.2rem, 2.6vw, 1.7rem);
        letter-spacing: 0.08em;
        color: #0b0b0b;
        background: #fff;
        border: 4px solid #0b0b0b;
        padding: 0.55em 1.6em;
        transform: skewX(-12deg);
        box-shadow: 8px 8px 0 #e60012;
        animation: pulse 1.1s ease-in-out infinite;
        transition: background 0.12s, color 0.12s, box-shadow 0.12s;
    }
    .t-start span { display: block; transform: skewX(12deg); }
    .t-start:hover,
    .t-start:focus-visible {
        background: #0b0b0b;
        color: #fff;
        border-color: #fff;
        box-shadow: 8px 8px 0 #f5c400;
        outline: none;
    }
    @keyframes pulse {
        50% { transform: skewX(-12deg) scale(1.06); }
    }
    .t-hint {
        margin-top: 1.4rem;
        font-family: "Inter", sans-serif;
        font-size: 0.8rem;
        color: #bdbdbd;
        letter-spacing: 0.04em;
    }
    .t-silent {
        background: none;
        border: 0;
        padding: 0;
        color: #fff;
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .t-skip {
        position: absolute;
        right: 1.5rem;
        bottom: 1.25rem;
        background: none;
        border: 0;
        color: #fff;
        font-size: 1rem;
        letter-spacing: 0.15em;
        opacity: 0.75;
    }
    .t-skip:hover, .t-skip:focus-visible { opacity: 1; color: #f5c400; outline: none; }

    /* ---------------------------------------------- the show */
    .show {
        position: absolute;
        inset: 0;
        overflow: hidden;
        background: #fff;
        visibility: hidden;
    }
    :global(#p5-intro.play) .show { visibility: visible; }
    :global(#p5-intro.play) .title {
        animation: title-out 0.16s ease-in forwards;
        pointer-events: none;
    }
    @keyframes title-out {
        to { opacity: 0; transform: scale(1.1); }
    }

    .s-slash { position: absolute; inset: -12%; }
    .s-red {
        background: #e60012;
        clip-path: polygon(0 0, 64% 0, 46% 100%, 0 100%);
        transform: translateX(-115%);
    }
    .s-seam {
        background: #fff;
        clip-path: polygon(62% 0, 67% 0, 49% 100%, 44% 100%);
        transform: translateX(115%);
    }
    .s-black {
        background: #0b0b0b;
        clip-path: polygon(67% 0, 100% 0, 100% 100%, 49% 100%);
        transform: translateX(115%);
    }
    :global(#p5-intro.play) .s-red { animation: in-l 0.3s cubic-bezier(0.15, 0.9, 0.25, 1.15) both; }
    :global(#p5-intro.play) .s-seam { animation: in-r 0.3s cubic-bezier(0.15, 0.9, 0.25, 1.15) 0.42s both; }
    :global(#p5-intro.play) .s-black { animation: in-r 0.3s cubic-bezier(0.15, 0.9, 0.25, 1.15) 0.45s both; }
    @keyframes in-l { from { transform: translateX(-115%); } to { transform: none; } }
    @keyframes in-r { from { transform: translateX(115%); } to { transform: none; } }

    .s-burst {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 260vmax;
        height: 260vmax;
        margin: -130vmax 0 0 -130vmax;
        background: repeating-conic-gradient(rgba(0, 0, 0, 0.22) 0 6deg, transparent 6deg 18deg);
        opacity: 0;
    }
    :global(#p5-intro.play) .s-burst {
        animation:
            burst-in 0.4s ease-out 0.45s forwards,
            spin 9s linear 0.45s infinite;
    }
    @keyframes burst-in { from { opacity: 0; scale: 0.5; } to { opacity: 1; scale: 1; } }

    .s-dots {
        position: absolute;
        inset: 0;
        background: radial-gradient(rgba(0, 0, 0, 0.3) 1.5px, transparent 2px) 0 0 / 10px 10px;
        mask-image: linear-gradient(115deg, #000 0%, transparent 45%, transparent 60%, #000 100%);
        opacity: 0.8;
    }

    .s-name {
        position: absolute;
        inset: 0;
        display: flex;
        flex-wrap: wrap;
        align-content: center;
        justify-content: center;
        gap: 1.2vw 3vw;
        transform: rotate(-7deg);
        padding: 0 4vw;
    }
    .s-word { display: flex; gap: 0.5vw; }
    .s-l {
        display: inline-block;
        font-size: clamp(3.2rem, min(13vw, 19vh), 12rem);
        line-height: 1;
        padding: 0.04em 0.13em 0;
        border: 0.05em solid #0b0b0b;
        box-shadow: 0.07em 0.07em 0 #0b0b0b;
        opacity: 0;
        transform: rotate(var(--r));
    }
    .s-a { background: #fff; color: #0b0b0b; }
    .s-b { background: #0b0b0b; color: #fff; border-color: #fff; box-shadow: 0.07em 0.07em 0 #e60012; font-family: "Libre Baskerville", serif; font-style: italic; }
    .s-c { background: #f5c400; color: #0b0b0b; }
    .s-d { background: #fff; color: #e60012; font-family: "JetBrains Mono", monospace; font-weight: 700; }
    .s-e { background: #e60012; color: #fff; }
    .s-f { background: #fff; color: #0b0b0b; font-family: "Libre Baskerville", serif; font-weight: 700; }
    :global(#p5-intro.play) .s-l { animation: slam 0.24s cubic-bezier(0.2, 1.5, 0.35, 1) var(--d) both; }
    @keyframes slam {
        0% { opacity: 0; transform: scale(2.8) rotate(calc(var(--r) * -4)); }
        55% { opacity: 1; }
        100% { opacity: 1; transform: scale(1) rotate(var(--r)); }
    }

    .s-stamp {
        flex-basis: 100%;
        margin: 0 0 1vh;
        text-align: center;
        font-style: italic;
        font-size: clamp(1.5rem, min(4.4vw, 6.5vh), 3.6rem);
        color: #fff;
        -webkit-text-stroke: 2px #0b0b0b;
        text-shadow: 5px 5px 0 #0b0b0b;
        opacity: 0;
    }
    :global(#p5-intro.play) .s-stamp { animation: stamp 0.26s cubic-bezier(0.2, 1.5, 0.35, 1) 2.7s both; }
    @keyframes stamp {
        from { opacity: 0; transform: scale(2.2); }
        to { opacity: 1; transform: scale(1); }
    }

    .s-tag {
        flex-basis: 100%;
        display: flex;
        justify-content: center;
        margin-top: 2.5vh;
    }
    .s-tag span {
        color: #fff;
        background: #0b0b0b;
        border: 3px solid #fff;
        font-size: clamp(0.9rem, min(2.4vw, 3.4vh), 1.9rem);
        letter-spacing: 0.12em;
        padding: 0.35em 1.2em;
        box-shadow: 6px 6px 0 #e60012;
        transform: skewX(-14deg) translateX(-140vw);
    }
    :global(#p5-intro.play) .s-tag span { animation: tag-in 0.36s cubic-bezier(0.15, 0.9, 0.25, 1.1) 2.25s both; }
    @keyframes tag-in {
        from { transform: skewX(-14deg) translateX(-140vw); }
        to { transform: skewX(-14deg) translateX(0); }
    }

    .s-flash { position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; }
    :global(#p5-intro.play) .s-flash { animation: flash-a 0.35s ease-out, flash-b 0.5s ease-out 3.15s; }
    @keyframes flash-a { from { opacity: 0.95; } to { opacity: 0; } }
    @keyframes flash-b { from { opacity: 0.85; } to { opacity: 0; } }

    /* final hit: punch, then a diagonal wipe reveals the site */
    :global(#p5-intro.exit) .s-name { animation: punch 0.3s ease-out; }
    @keyframes punch {
        40% { transform: rotate(-7deg) scale(1.08); }
        to { transform: rotate(-7deg) scale(1); }
    }
    :global(#p5-intro.exit) .show { animation: wipe 0.62s cubic-bezier(0.75, 0, 0.25, 1) 0.08s forwards; }
    @keyframes wipe {
        from { clip-path: polygon(0% 0%, 130% 0%, 130% 100%, -30% 100%); }
        to { clip-path: polygon(130% 0%, 130% 0%, 130% 100%, 100% 100%); }
    }
</style>

<script>
    import { playStinger } from "../../scripts/stinger";

    const KEY = "p5-intro-seen";
    const EXIT_AT = 3150; // ms, beat 7
    const DONE_AT = 3850;

    const root = document.getElementById("p5-intro");
    const html = document.documentElement;

    if (root && html.hasAttribute("data-intro")) {
        const startBtn = root.querySelector<HTMLButtonElement>("[data-start]")!;
        const silentBtn = root.querySelector<HTMLButtonElement>("[data-silent]")!;
        const skipBtn = root.querySelector<HTMLButtonElement>("[data-skip]")!;
        const title = root.querySelector<HTMLElement>("[data-title]")!;
        const letterTimes = [...root.querySelectorAll<HTMLElement>("[data-d]")].map((el) => +el.dataset.d!);

        let started = false;
        let finished = false;
        let ctx: AudioContext | null = null;
        const timers: number[] = [];

        const finish = () => {
            if (finished) return;
            finished = true;
            timers.forEach(clearTimeout);
            try { localStorage.setItem(KEY, "1"); } catch {}
            html.removeAttribute("data-intro");
            root.remove();
            document.removeEventListener("keydown", onKey);
            // let the final chord ring out, then release the audio device
            if (ctx) setTimeout(() => ctx?.close().catch(() => {}), 2500);
        };

        const play = (withSound: boolean) => {
            if (started) return;
            started = true;
            if (withSound) {
                try {
                    const AC = window.AudioContext || (window as any).webkitAudioContext;
                    ctx = new AC();
                    ctx.resume();
                    playStinger(ctx, letterTimes);
                } catch { ctx = null; }
            }
            root.classList.add("play");
            timers.push(window.setTimeout(() => root.classList.add("exit"), EXIT_AT));
            timers.push(window.setTimeout(finish, DONE_AT));
        };

        const onKey = (e: KeyboardEvent) => {
            if (e.key === "Escape") return finish();
            if (e.key === "Tab" || e.altKey || e.ctrlKey || e.metaKey) return;
            // Enter/Space on a focused button already fire click
            if ((e.key === "Enter" || e.key === " ") && document.activeElement instanceof HTMLButtonElement) return;
            if (!started) { e.preventDefault(); play(true); }
        };

        startBtn.addEventListener("click", (e) => { e.stopPropagation(); play(true); });
        silentBtn.addEventListener("click", (e) => { e.stopPropagation(); play(false); });
        skipBtn.addEventListener("click", (e) => { e.stopPropagation(); finish(); });
        title.addEventListener("click", () => play(true));
        document.addEventListener("keydown", onKey);
        startBtn.focus({ preventScroll: true });
    }
</script>
