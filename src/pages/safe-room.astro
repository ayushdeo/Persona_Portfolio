---
import PersonaLayout from "../components/layout/PersonaLayout.astro";
import PageTransition from "../components/motion/PageTransition";
import PersonaButton from "../components/ui/PersonaButton";
import MaskReveal from "../components/ui/MaskReveal";
import USCOverlay from "../components/ui/USCOverlay.astro";
import { offDuty } from "../data/profile";

const accent = {
    red: { border: "border-persona-red", text: "text-persona-red", shadow: "shadow-[5px_5px_0px_#e60012]" },
    blue: { border: "border-persona-blue", text: "text-persona-blue", shadow: "shadow-[5px_5px_0px_#0095f6]" },
    yellow: { border: "border-persona-yellow", text: "text-persona-yellow", shadow: "shadow-[5px_5px_0px_#f5c400]" },
    purple: { border: "border-persona-purple", text: "text-persona-purple", shadow: "shadow-[5px_5px_0px_#9d50bb]" },
} as const;
---

<PersonaLayout title="SAFE ROOM" mode="red">
    <USCOverlay />
    <PageTransition client:load>
        <div
            class="flex flex-col items-center justify-start pt-4 pb-24 md:pb-[30vh] px-0 md:px-16 relative"
        >
            <div
                class="max-w-4xl w-full bg-persona-black/90 border-2 border-persona-accent p-6 md:p-16 relative backdrop-blur-sm shadow-[10px_10px_0px_theme('colors.persona.accent')] transform -skew-x-2"
            >
                <MaskReveal client:visible>
                    <h2
                        class="text-5xl font-display text-white mb-8 border-b-2 border-gray-700 pb-4"
                    >
                        MISSION BRIEFING
                    </h2>
                </MaskReveal>

                <div
                    class="space-y-6 text-lg text-gray-300 font-ui leading-relaxed"
                >
                    <MaskReveal client:visible delay={0.2}>
                        <p>
                            I’m a product-focused engineer obsessed with <strong
                                class="text-white">style</strong
                            > and <strong class="text-white">function</strong>.
                            I build AI-powered systems that scale, adapt, and
                            empower creativity.
                        </p>
                    </MaskReveal>

                    <MaskReveal client:visible delay={0.3}>
                        <p>
                            My philosophy is simple: <em
                                class="text-persona-yellow"
                                >If it's not stylish, it's not finished.</em
                            >
                        </p>
                    </MaskReveal>
                </div>

                <!-- Education Record -->
                <div
                    class="mt-12 w-full border-t-2 border-dashed border-gray-700 pt-8"
                >
                    <h3 class="text-white font-display text-3xl mb-8">
                        EDUCATION RECORD
                    </h3>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <!-- USC -->
                        <div
                            class="bg-gray-900/50 p-6 border-l-4 border-persona-accent"
                        >
                            <h4 class="text-persona-accent font-bold text-xl">
                                UNIVERSITY OF SOUTHERN CALIFORNIA
                            </h4>
                            <p class="text-white font-bold">
                                MASTER OF SCIENCE — COMPUTER SCIENCE
                            </p>
                            <div class="flex justify-between items-center mb-4">
                                <p class="text-gray-400 text-sm">
                                    AUG 2025 — MAY 2027
                                </p>
                                <p
                                    class="text-white font-mono text-sm border border-white px-2"
                                >
                                    CGPA: 3.42 / 4.0
                                </p>
                            </div>

                            <p
                                class="text-xs text-persona-yellow uppercase font-bold mb-2"
                            >
                                ACTIVE ROLES
                            </p>
                            <ul class="text-gray-300 text-sm space-y-1">
                                <li>• GRIDS USC — Director of AI</li>
                                <li>
                                    • Daily Trojan — Social Media Design Staffer
                                </li>
                                <li>
                                    • ICU Multimodal Healthcare AI — Project
                                    Lead
                                </li>
                            </ul>

                            <p
                                class="text-xs text-persona-yellow uppercase font-bold mt-4 mb-2"
                            >
                                HONORS
                            </p>
                            <ul class="text-gray-300 text-sm space-y-1">
                                <li>• Crowe National Case Competition — 1st Place</li>
                                <li>• USC Global Health Case Competition — 3rd Place</li>
                            </ul>
                        </div>

                        <!-- NMIMS -->
                        <div
                            class="bg-gray-900/50 p-6 border-l-4 border-gray-600"
                        >
                            <h4 class="text-white font-bold text-xl">
                                NMIMS UNIVERSITY
                            </h4>
                            <p class="text-white font-bold">
                                BACHELOR OF TECHNOLOGY — IT
                            </p>
                            <div class="flex justify-between items-center mb-4">
                                <p class="text-gray-400 text-sm">
                                    SEP 2021 — MAY 2025
                                </p>
                                <p
                                    class="text-white font-mono text-sm border border-white px-2"
                                >
                                    CGPA: 3.62 / 4.0
                                </p>
                            </div>

                            <p
                                class="text-xs text-gray-500 uppercase font-bold mb-2"
                            >
                                HONORS
                            </p>
                            <ul class="text-gray-300 text-sm space-y-1">
                                <li>
                                    • Technical Research Award — Batch of 2025
                                </li>
                                <li>
                                    • Student Ambassador Award — Batch of 2025
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Off the clock: the human behind the résumé -->
                <section
                    aria-labelledby="off-clock"
                    class="mt-12 w-full border-t-2 border-dashed border-gray-700 pt-8"
                >
                    <div class="flex flex-wrap items-baseline justify-between gap-2 mb-6">
                        <h3 id="off-clock" class="text-white font-display text-3xl">
                            OFF THE CLOCK
                        </h3>
                        <p class="font-ui font-black text-[11px] tracking-[0.25em] text-gray-500">
                            SOCIAL STATS // ALL MAXED
                        </p>
                    </div>

                    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
                        {
                            offDuty.map((o) => {
                                const a = accent[o.accent as keyof typeof accent];
                                return (
                                    <article class={`bg-persona-black border-2 ${a.border} ${a.shadow} p-5 skew-x-2`}>
                                        <div class="flex items-center justify-between gap-2">
                                            <span class={`font-ui font-black text-[10px] tracking-[0.25em] ${a.text}`}>
                                                {o.stat}
                                            </span>
                                            <span class="font-mono text-[10px] text-gray-500">
                                                RANK: {o.rank}
                                            </span>
                                        </div>
                                        <div class="flex gap-[3px] mt-2" aria-hidden="true">
                                            {[...Array(5)].map(() => (
                                                <span class={`h-1.5 flex-1 -skew-x-12 bg-current ${a.text}`} />
                                            ))}
                                        </div>
                                        <h4 class="font-display text-2xl text-white leading-tight mt-3">
                                            {o.title}
                                        </h4>
                                        <p class="font-ui text-[15px] text-gray-300 leading-relaxed mt-1">
                                            {o.body}
                                        </p>
                                    </article>
                                );
                            })
                        }
                    </div>
                </section>

                <div class="mt-12 flex flex-col items-center gap-6 w-full">
                    <div class="flex flex-col md:flex-row gap-6">
                        <PersonaButton
                            href="mailto:theayushdeo@gmail.com"
                            client:visible
                        >
                            LET'S TALK
                        </PersonaButton>
                        <PersonaButton
                            href={`${import.meta.env.BASE_URL}/resume.pdf`}
                            external
                            client:visible
                        >
                            DOWNLOAD DATA
                        </PersonaButton>
                    </div>

                    <!-- External Links Footer -->
                    <!-- Footer Signature -->
                    <div
                        class="mt-8 text-center border-t border-gray-800 pt-6 w-full max-w-lg"
                    >
                        <p class="font-ui text-gray-500 text-sm">
                            Designed by <span class="text-white">Ayush D.</span> with
                            🤍, from Mumbai to Los Angeles
                        </p>
                    </div>
                </div>

                <!-- Gentle floating mask icon decor -->
                <div
                    class="absolute -right-10 -top-10 text-9xl text-persona-red opacity-20 rotate-12 pointer-events-none select-none"
                >
                    🎭
                </div>
            </div>
        </div>
    </PageTransition>
</PersonaLayout>
