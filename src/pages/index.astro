---
import PersonaLayout from "../components/layout/PersonaLayout.astro";
import MaskReveal from "../components/ui/MaskReveal";
import PageTransition from "../components/motion/PageTransition";
import ChaosBackground from "../components/ui/ChaosBackground.astro";
import MissionVisuals from "../components/ui/MissionVisuals";
import CallingCard from "../components/ui/CallingCard.astro";
---

<PersonaLayout title="MISSION START" intro>
    <ChaosBackground />

    <PageTransition client:load>
        <div
            class="relative min-h-full w-full grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-4 items-center px-1 md:px-6 xl:px-10 py-2 lg:py-0"
        >
            <MissionVisuals client:load />

            <!-- Kinetic type + nameplate -->
            <div
                class="lg:col-span-5 2xl:col-span-6 relative z-10 pointer-events-none"
            >
                <div
                    class="transform -rotate-6 origin-center md:origin-left scale-90 md:scale-100"
                >
                    <MaskReveal client:load delay={0.2} className="p-6 -m-6">
                        <h1
                            class="text-6xl sm:text-7xl lg:text-[5.5rem] xl:text-[6.5rem] 2xl:text-[10rem] font-display leading-[0.8] tracking-tighter italic text-white drop-shadow-[8px_8px_0px_#000]"
                            style="-webkit-text-stroke: 3px black;"
                        >
                            <span class="relative inline-block px-4">
                                <span
                                    class="absolute left-0 top-1/2 w-full h-1/2 bg-persona-black transform -skew-x-12 -z-10 translate-y-2"
                                ></span>
                                TAKE
                            </span>
                        </h1>
                    </MaskReveal>

                    <div class="ml-8 md:ml-24 -mt-6 md:-mt-10">
                        <MaskReveal
                            client:load
                            delay={0.4}
                            className="p-6 -m-6"
                        >
                            <p
                                class="text-6xl sm:text-7xl lg:text-[5.5rem] xl:text-[6.5rem] 2xl:text-[10rem] font-display leading-[0.8] tracking-tighter italic text-persona-black"
                                style="-webkit-text-stroke: 2px white; text-shadow: 6px 6px 0px white;"
                                aria-hidden="true"
                            >
                                YOUR
                            </p>
                        </MaskReveal>
                    </div>

                    <div class="ml-2 md:ml-10 -mt-6 md:-mt-10">
                        <MaskReveal
                            client:load
                            delay={0.6}
                            className="p-6 -m-6"
                        >
                            <p
                                class="text-7xl sm:text-8xl lg:text-[6.5rem] xl:text-[7.5rem] 2xl:text-[12rem] font-display leading-[0.8] tracking-tighter italic text-persona-red drop-shadow-[10px_10px_0px_#000]"
                                style="-webkit-text-stroke: 4px black;"
                                aria-hidden="true"
                            >
                                SHOT
                            </p>
                        </MaskReveal>
                    </div>
                </div>

                <!-- Nameplate: who this is, at a glance -->
                <MaskReveal client:load delay={0.9}>
                    <div
                        class="inline-block bg-white border-4 border-black shadow-[6px_6px_0px_#e60012] -skew-x-12 px-5 py-2"
                    >
                        <div class="skew-x-12">
                            <p
                                class="font-display text-3xl md:text-4xl text-black leading-none"
                            >
                                AYUSH DEO
                            </p>
                            <p
                                class="font-ui font-black text-[11px] md:text-xs tracking-[0.2em] text-gray-700 mt-1"
                            >
                                APPLIED AI RESEARCH · M.S. CS @ USC
                            </p>
                        </div>
                    </div>
                </MaskReveal>
            </div>

            <!-- Calling card: the elevator pitch -->
            <div
                class="lg:col-span-7 2xl:col-span-6 relative z-20 flex lg:justify-end"
            >
                <MaskReveal client:load delay={1.0} className="w-full flex lg:justify-end lg:-my-5">
                    <CallingCard />
                </MaskReveal>
            </div>
        </div>
    </PageTransition>
</PersonaLayout>
