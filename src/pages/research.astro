---
import PersonaLayout from "../components/layout/PersonaLayout.astro";
import PageTransition from "../components/motion/PageTransition";
import PersonaButton from "../components/ui/PersonaButton";
import {
    links,
    objective,
    activeMissions,
    researchInterests,
    publications,
} from "../data/profile";

const springer = publications.filter((p) => p.venue.includes("Springer")).length;
const indexed = publications.filter((p) => p.authors);
const firstAuthor = indexed.filter((p) => p.authors!.startsWith("A. Deo")).length;
const years = publications.map((p) => +p.year);

const dossier = [
    { label: "PEER-REVIEWED WORKS", value: String(publications.length) },
    { label: "SPRINGER PUBLICATIONS", value: String(springer) },
    { label: "FIRST AUTHOR (SCHOLAR-INDEXED)", value: `${firstAuthor}/${indexed.length}` },
    { label: "ACTIVE SINCE", value: String(Math.min(...years)) },
];

const stamp = {
    PUBLISHED: "bg-persona-yellow text-black border-black",
    PRESENTED: "bg-white text-black border-black",
    "UNDER REVIEW": "bg-transparent text-persona-yellow border-persona-yellow border-dashed",
};

// Split author list so "A. Deo" can be highlighted
const authorParts = (a: string) => a.split(/(A\. Deo)/);
---

<PersonaLayout title="RESEARCH PROWESS" mode="yellow">
    <PageTransition client:load>
        <div class="max-w-6xl mx-auto space-y-16 pb-12 md:px-4">
            <!-- ======================================== HEADER -->
            <header class="grid lg:grid-cols-12 gap-10 items-end pt-2">
                <div class="lg:col-span-7">
                    <p
                        class="font-ui font-black text-[11px] tracking-[0.3em] text-gray-400 mb-3"
                    >
                        ARCANA: THE PRIESTESS // KNOWLEDGE
                    </p>
                    <h1
                        class="text-6xl md:text-8xl font-display leading-[0.85] tracking-tighter text-white"
                    >
                        RESEARCH<br /><span class="text-persona-yellow"
                            >PROWESS</span
                        >
                    </h1>
                    <p
                        class="font-ui text-lg text-gray-200 leading-relaxed max-w-xl mt-6 border-l-4 border-persona-yellow pl-5"
                    >
                        Peer-reviewed work across NLP, computer vision and
                        applied analytics, first author on every
                        Scholar-indexed paper. Next up: <strong
                            class="text-white">{objective.toLowerCase()}</strong
                        >.
                    </p>
                    <ul class="flex flex-wrap gap-2 mt-6" aria-label="Research interests">
                        {
                            researchInterests.map((r) => (
                                <li class="bg-persona-yellow text-black font-ui font-black text-xs tracking-wider px-3 py-1 border-2 border-black -skew-x-12">
                                    <span class="block skew-x-12">{r.toUpperCase()}</span>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <!-- Scholar dossier -->
                <aside
                    class="lg:col-span-5 bg-white text-black border-4 border-black shadow-[10px_10px_0px_#f5c400] p-6 md:-rotate-1"
                    aria-label="Publication summary"
                >
                    <p
                        class="font-display text-2xl leading-none border-b-4 border-black pb-2 mb-4"
                    >
                        SCHOLAR DOSSIER
                    </p>
                    <dl class="divide-y-2 divide-dashed divide-gray-300">
                        {
                            dossier.map((d) => (
                                <div class="flex items-baseline justify-between gap-4 py-2">
                                    <dt class="font-ui font-bold text-xs tracking-wider text-gray-600">
                                        {d.label}
                                    </dt>
                                    <dd class="font-display text-3xl leading-none">
                                        {d.value}
                                    </dd>
                                </div>
                            ))
                        }
                    </dl>
                    <PersonaButton
                        href={links.scholar}
                        external
                        className="mt-5 w-full text-base py-2 border-black"
                        client:visible
                    >
                        Google Scholar ↗
                    </PersonaButton>
                </aside>
            </header>

            <!-- ======================================== ACTIVE INVESTIGATIONS -->
            <section aria-labelledby="active">
                <div class="flex items-center gap-4 mb-6">
                    <h2
                        id="active"
                        class="font-display text-4xl md:text-5xl text-white bg-persona-black border-l-8 border-persona-yellow pl-4"
                    >
                        ACTIVE INVESTIGATIONS
                    </h2>
                    <div class="h-1 flex-1 bg-gray-800"></div>
                </div>

                <div class="grid md:grid-cols-3 gap-5">
                    <article
                        class="bg-persona-yellow text-black border-4 border-black p-5 shadow-[6px_6px_0px_#fff]"
                    >
                        <p
                            class="font-ui font-black text-[11px] tracking-[0.2em]"
                        >
                            PRIMARY OBJECTIVE
                        </p>
                        <p class="font-display text-3xl leading-tight mt-2">
                            {objective}
                        </p>
                    </article>
                    {
                        activeMissions.map((m) => (
                            <article class="bg-persona-black border-4 border-white p-5 shadow-[6px_6px_0px_#f5c400]">
                                <p class="font-ui font-black text-[11px] tracking-[0.2em] text-persona-yellow flex items-center gap-2">
                                    <span class="w-2 h-2 rounded-full bg-persona-yellow animate-pulse" />
                                    {m.status}
                                </p>
                                <p class="font-display text-3xl leading-tight text-white mt-2">
                                    {m.title}
                                </p>
                                <p class="font-ui text-sm text-gray-300 mt-1">{m.detail}</p>
                            </article>
                        ))
                    }
                </div>
            </section>

            <!-- ======================================== CASE FILES -->
            <section aria-labelledby="files">
                <div class="flex items-center gap-4 mb-2">
                    <h2
                        id="files"
                        class="font-display text-4xl md:text-5xl text-white bg-persona-black border-l-8 border-persona-yellow pl-4"
                    >
                        CASE FILES
                    </h2>
                    <div class="h-1 flex-1 bg-gray-800"></div>
                </div>
                <p class="font-ui text-sm text-gray-400 mb-8">
                    Every paper, latest first. My name in each byline is
                    highlighted <span class="text-persona-yellow font-bold"
                        >like this</span
                    >.
                </p>

                <ol class="space-y-5">
                    {
                        publications.map((p, i) => (
                            <li>
                                <article class="group relative grid grid-cols-[auto,1fr] gap-x-5 md:gap-x-8 bg-gray-900/70 border-2 border-gray-700 hover:border-persona-yellow transition-colors p-5 md:p-6">
                                    <div class="flex flex-col items-start gap-3">
                                        <span class="font-mono text-4xl md:text-5xl text-persona-red leading-none">
                                            {String(i + 1).padStart(2, "0")}
                                        </span>
                                    </div>

                                    <div class="min-w-0">
                                        <div class="flex flex-wrap items-center gap-2 mb-2">
                                            <span
                                                class={`font-ui font-black text-[10px] tracking-[0.2em] px-2 py-0.5 border-2 -skew-x-12 ${stamp[p.status]}`}
                                            >
                                                <span class="block skew-x-12">{p.status}</span>
                                            </span>
                                            <span class="font-ui font-black text-[10px] tracking-[0.2em] text-gray-400">
                                                {p.tag} · {p.year}
                                            </span>
                                        </div>

                                        <h3 class="font-ui normal-case font-bold text-lg md:text-xl text-white leading-snug group-hover:text-persona-yellow transition-colors">
                                            {p.title}
                                        </h3>

                                        {p.authors && (
                                            <p class="font-ui text-sm text-gray-400 mt-1">
                                                {authorParts(p.authors).map((part) =>
                                                    part === "A. Deo" ? (
                                                        <strong class="text-persona-yellow">{part}</strong>
                                                    ) : (
                                                        part
                                                    ),
                                                )}
                                            </p>
                                        )}

                                        <p class="font-ui text-sm text-gray-300 italic mt-1">
                                            {p.venue}
                                        </p>

                                        <p class="font-ui text-[15px] text-gray-200 leading-relaxed mt-3 max-w-3xl">
                                            {p.summary}
                                        </p>

                                        {p.link && (
                                            <a
                                                href={p.link}
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="inline-block mt-3 font-mono text-xs text-persona-yellow underline underline-offset-4 hover:text-white"
                                            >
                                                DOI: {p.link.replace("https://doi.org/", "")} ↗
                                            </a>
                                        )}
                                    </div>
                                </article>
                            </li>
                        ))
                    }
                </ol>
            </section>

            <div class="text-right">
                <a
                    href={`${import.meta.env.BASE_URL}/safe-room/`}
                    class="inline-block font-display text-xl text-gray-400 hover:text-persona-yellow transition-colors"
                >
                    ENTER THE SAFE ROOM →
                </a>
            </div>
        </div>
    </PageTransition>
</PersonaLayout>
